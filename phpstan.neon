includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - database
        - routes

    # Livello iniziale prudente: il progetto non ha mai avuto analisi statica,
    # partire da un livello alto (9-10) produrrebbe centinaia di segnalazioni
    # perlopiu' rumorose sui pattern dinamici tipici di Filament/Eloquent
    # (magic properties, relazioni, form state). Si alza gradualmente man
    # mano che il codice viene ripulito (vedi baseline).
    level: 5

    excludePaths:
        - app/Console/Commands/*
        - database/data/*

    # Fuori dal progetto di proposito: con Docker su macOS la cartella e' un
    # bind mount, e i processi paralleli di PHPStan si pestano i piedi
    # rinominando i file di cache ("rename(): No such file or directory").
    # Il risultato era un [ERROR] Found 1 error e l'analisi che non girava
    # piu' — cioe' phpstan spento senza che nessuno se ne accorgesse.
    tmpDir: /tmp/phpstan
