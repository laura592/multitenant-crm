# Bozza .env per il deploy reale su hosting condiviso cPanel (alexcaffe.com,
# utente nbalexca). Copiare come .env sul server.
#
# Setup rapido: per avviare l'app bastano queste 3 variabili:
# - DB_DATABASE
# - DB_USERNAME
# - DB_PASSWORD
#
# Tutto il resto e' gia' preconfigurato con valori sicuri/default di produzione.
# Vedi piano di cutover in docs/checklist-rilascio.md per il contesto completo.

APP_NAME="Alex Partner Hub"
APP_ENV=production
APP_KEY=
# APP_DEBUG=false in produzione, SEMPRE: con true espone stack trace agli
# utenti (dati e struttura del DB inclusi). Da non toccare per "debuggare
# più comodamente" nemmeno temporaneamente.
APP_DEBUG=false
APP_URL=https://app.alexcaffe.com

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug in locale, ma in produzione LOG_LEVEL=error: 'debug' scrive troppo e
# riempie lo storage di un hosting condiviso (quota disco limitata).
LOG_LEVEL=error

# Database MySQL creato da cPanel ("MySQL Databases"), non riusare quello
# della vecchia app. Nome utente/DB con prefisso account cPanel (nbalexca_...).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nbalexca_multitenant_crm
DB_USERNAME=nbalexca_crm
DB_PASSWORD=

# Solo per il run (unico, in finestra di manutenzione) di `import:legacy`
# (docs/architecture.md §8.1): nome del DB della vecchia app, sullo stesso
# host/credenziali di DB_* sopra (vedi config/database.php, connessione
# "legacy" - non ha variabili host/utente/password proprie). Da rimuovere o
# lasciare vuoto dopo il cutover, non serve più a regime.
LEGACY_DB_DATABASE=nbalexca_app_preventivi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database, non sync: su hosting condiviso non ci sono processi persistenti,
# il worker gira via cron (vedi istruzioni di deploy) - sync eseguirebbe PDF
# ed email dentro la richiesta HTTP stessa, rallentando ogni salvataggio.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mailer letto da .env (config/mail.php -> env('MAIL_MAILER', ...)).
# Imposta qui il driver reale del tuo ambiente (es. smtp).
# MAIL_SCHEME va lasciato vuoto (o rimosso): config/mail.php lo deriva da
# solo dalla porta (465 => smtps, altrimenti smtp) - "tls"/"ssl" NON sono
# scheme validi per Symfony Mailer e causano "The 'ssl' scheme is not
# supported...". Con porta 465 (SSL/TLS implicito) va bene lasciarlo vuoto;
# con porta 587 (STARTTLS) idem, va lasciato vuoto.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Dati reali del tenant master (Alex), usati dal TenantSeeder solo se i campi
# nel DB sono vuoti - compilare con i dati reali dell'azienda prima del primo
# deploy, non lasciare i placeholder di sviluppo.
TENANT_DEFAULT_SLUG=alex
TENANT_DEFAULT_NAME=Alex
TENANT_DEFAULT_LEGAL_NAME=
TENANT_DEFAULT_VAT_NUMBER=
TENANT_DEFAULT_TAX_CODE=
TENANT_DEFAULT_SDI=
TENANT_DEFAULT_STREET=
TENANT_DEFAULT_POSTAL_CODE=
TENANT_DEFAULT_CITY=
TENANT_DEFAULT_PROVINCE=
TENANT_DEFAULT_PHONE=
TENANT_DEFAULT_FAX=
TENANT_DEFAULT_EMAIL=

VITE_APP_NAME="${APP_NAME}"
